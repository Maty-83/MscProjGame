  m_OnCullStateChanged:
    m_PersistentCalls:
      m_Calls: []
  m_text: 'X<color=orange> is the universal spacebrake. It will automatically cut
    throttles and use thrusters to bring you to a stop (Including spin). If used
    alongside other controls, it will not touch those axes.</color>


    Backspace<color=orange>
    will reset a level. You wil start at the countdown again. No need to continue
    an attempt where you already crashed!


    When in a level, using </color>Escape<color=orange>
    will immediately bring you back to the main menu.</color>'
  m_isRightToLeft: 0
  m_fontAsset: {fileID: 11400000, guid: 8f586378b4e144a9851e7b34d9b748ee, type: 2}
  m_sharedMaterial: {fileID: 2180264, guid: 8f586378b4e144a9851e7b34d9b748ee, type: 2}
